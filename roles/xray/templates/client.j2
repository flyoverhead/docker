{
{% if (xray_clients_config.dns | default({})).items() | length > 0 %}
  "dns": {
{% for key, value in xray_clients_config.dns.items() %}
    {{ key | to_nice_json(sort_keys=false) |
    trim | indent(4) }}: {{ value | to_nice_json(sort_keys=false) |
    trim | indent(4) }}{{ ',' if not loop.last }}
{% endfor %}
  },
{% endif %}
{% set client_inbounds = (xray_client_inbounds | default({}))[item.email | default('')]
   | default(xray_clients_config.inbounds | default([])) %}
{% if client_inbounds | length > 0 %}
  "inbounds": [
{% for inbound in client_inbounds %}
    {
{% for key, value in inbound.items() %}
      {{ key | to_nice_json(sort_keys=false) |
      trim | indent(4) }}: {{ value | to_nice_json(sort_keys=false) |
      trim | indent(4) }}{{ ',' if not loop.last }}
{% endfor %}
    }{{ ',' if not loop.last }}
{% endfor %}
  ],
{% endif %}
  "outbounds": [
{% for outbound in xray_clients_config.outbounds %}
    {
{% for key, value in outbound.items() %}
      {{ key | to_nice_json(sort_keys=false) |
      trim | indent(4) }}: {{ value | to_nice_json(sort_keys=false) |
      trim | indent(4) }}{{ ',' if not loop.last }}
{% endfor %}
    }{{ ',' if not loop.last }}
{% endfor %}
  ],
{% if (xray_clients_config.routing | default({})).items() | length > 0 %}
  "routing": {
{% for key, value in xray_clients_config.routing.items() %}
    {{ key | to_nice_json(sort_keys=false) |
    trim | indent(4) }}: {{ value | to_nice_json(sort_keys=false) |
    trim | indent(4) }}{{ ',' if not loop.last }}
{% endfor %}
  },
{% endif %}
{% if (xray_clients_config.log | default({})).items() | length > 0 %}
  "log": {
{% for key, value in xray_clients_config.log.items() %}
    {{ key | to_nice_json(sort_keys=false) |
    trim | indent(4) }}: {{ value | to_nice_json(sort_keys=false) |
    trim | indent(4) }}{{ ',' if not loop.last }}
{% endfor %}
  }
{% endif %}
}
