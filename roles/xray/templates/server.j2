{#
  `log` is rendered last and unconditionally: every other section is optional
  and emits a trailing comma, so an optional section in last position produces
  invalid JSON the moment it is left empty.
#}
{
{% if (xray_server_config.dns | default({})).items() | length > 0 %}
  "dns": {
{% for key, value in xray_server_config.dns.items() %}
    {{ key | to_nice_json(sort_keys=false) |
    trim | indent(4) }}: {{ value | to_nice_json(sort_keys=false) |
    trim | indent(4) }}{{ ',' if not loop.last }}
{% endfor %}
  },
{% endif %}
  "inbounds": [
    {
      "listen": "{{ xray_server_config.listening_address }}",
      "port": {{ xray_server_config.listening_port }},
      "protocol": "vless",
      "tag": "{{ xray_server_config.tag }}",
      "settings": {
        "clients": [
{% for client in xray_all_clients %}
          {
            "email": "{{ client.email }}",
            "id": "{{ client.id }}",
            "flow": "{{ xray_server_config.flow }}"
          }{{ ',' if not loop.last }}
{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {{ xray_server_config.stream_settings |
      combine({'realitySettings':
        (xray_server_config.stream_settings.realitySettings | default({}))
        | combine(xray_reality_settings)}) |
      to_nice_json(indent=2, sort_keys=false) | trim | indent(6) }},
      "sniffing": {
          "enabled": true,
          "destOverride": [
              "http",
              "tls",
              "quic"
          ],
          "routeOnly": false
      }
    }
  ],
{% if xray_server_config.outbounds | default([]) | length > 0 %}
  "outbounds": [
{% for outbound in xray_server_config.outbounds %}
      {{ outbound | to_nice_json(indent=4, sort_keys=false) |
      trim | indent(6) }}{{ ',' if not loop.last }}
{% endfor %}
  ],
{% endif %}
{% if (xray_server_config.routing | default({})).items() | length > 0 %}
  "routing": {
{% for key, value in xray_server_config.routing.items() %}
    {{ key | to_nice_json(sort_keys=false) |
    trim | indent(4) }}: {{ value | to_nice_json(sort_keys=false) |
    trim | indent(4) }}{{ ',' if not loop.last }}
{% endfor %}
  },
{% endif %}
  "log": {
{% for key, value in (xray_server_config.log | default({})).items() %}
    {{ key | to_nice_json(sort_keys=false) |
    trim | indent(4) }}: {{ value | to_nice_json(sort_keys=false) |
    trim | indent(4) }}{{ ',' if not loop.last }}
{% endfor %}
  }
}
